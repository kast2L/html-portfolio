---
import BookCall from '../BookCall.astro';
import LeadForm from '../LeadForm.astro';
import { SITE } from '../../lib/site';
---

<section class="contact surface-night" id="contact" aria-labelledby="contact-title">
  <div class="contact-glow" aria-hidden="true"></div>

  <div class="container contact-grid">
    <div class="contact-pitch" data-reveal-solo>
      <h2 class="section-heading contact-heading" id="contact-title">
        Let’s turn operational friction into <span class="serif-italic">living software.</span>
      </h2>

      <p class="section-lead">
        Grab a 30-minute slot on my calendar and walk me through what you’re building or untangling — whether it’s a
        custom web app, Power&nbsp;BI suite, Power&nbsp;Apps portal, workflow, or platform governance initiative.
      </p>

      <div class="contact-cta-group">
        <BookCall location="cta" variant="glow" magnetic />
        <p class="contact-direct">
          Prefer email? Reach me directly at{' '}
          <a class="text-link" href={`mailto:${SITE.email}`}>{SITE.email}</a>
        </p>
      </div>

      <ul class="contact-promises">
        <li>30-minute architectural conversation — zero sales pitch</li>
        <li>Clear recommendation on stack, timeline, and fit</li>
        <li>Direct communication with Douglas Hill from day one</li>
      </ul>
    </div>

    <div class="contact-form-card" data-reveal-solo>
      <div class="form-card-head">
        <h3 class="form-card-title">Or send a quick project brief</h3>
        <p class="form-card-sub">I read every note personally and reply within one business day.</p>
      </div>
      <LeadForm />
    </div>
  </div>
</section>

<style>
  .contact {
    position: relative;
    padding-block: var(--section-pad);
    overflow: hidden;
  }

  .contact-glow {
    position: absolute;
    bottom: -14rem;
    left: 50%;
    transform: translateX(-50%);
    width: 68rem;
    height: 40rem;
    border-radius: 50%;
    background: radial-gradient(
      circle,
      rgba(255, 107, 74, 0.14) 0%,
      rgba(94, 194, 255, 0.06) 38%,
      transparent 70%
    );
    pointer-events: none;
  }

  .contact-grid {
    position: relative;
    z-index: 1;
    display: grid;
    gap: clamp(2.5rem, 2rem + 3vw, 4.5rem);
    align-items: start;
  }

  .contact-pitch {
    display: grid;
    gap: var(--s-5);
    justify-items: start;
  }

  .contact-heading {
    max-width: 16ch;
  }

  .contact-cta-group {
    display: grid;
    gap: var(--s-4);
    justify-items: start;
    width: 100%;
  }

  .contact-direct {
    font-size: var(--fs-small);
    color: var(--c-on-night-2);
    overflow-wrap: anywhere;
  }

  .contact-direct :global(.text-link) {
    min-height: 44px;
  }

  .contact-promises {
    display: grid;
    gap: 0.65rem;
    padding-top: var(--s-4);
    border-top: 1px solid var(--c-line-dark);
    width: 100%;
    font-size: var(--fs-small);
    color: var(--c-on-night-2);
  }

  .contact-promises li {
    position: relative;
    padding-left: 1.25rem;
  }

  .contact-promises li::before {
    content: '';
    position: absolute;
    left: 0;
    top: 0.55rem;
    width: 0.45rem;
    height: 0.45rem;
    border-radius: 50%;
    background: var(--c-coral);
  }

  .contact-form-card {
    padding: clamp(1.5rem, 1.2rem + 1.8vw, 2.6rem);
    border-radius: var(--r-card-lg);
    background: var(--c-glass-card);
    border: 1px solid var(--c-line-dark);
    -webkit-backdrop-filter: blur(18px);
    backdrop-filter: blur(18px);
    box-shadow: var(--shadow-stage);
  }

  .form-card-head {
    margin-bottom: var(--s-5);
    padding-bottom: var(--s-4);
    border-bottom: 1px solid var(--c-line-dark);
  }

  .form-card-title {
    font-size: var(--fs-card-title);
    color: var(--c-on-night);
  }

  .form-card-sub {
    margin-top: 0.3rem;
    font-size: var(--fs-small);
    color: var(--c-on-night-2);
  }

  @media (max-width: 639px) {
    .contact-cta-group :global(.btn) {
      width: 100%;
    }
  }

  @media (min-width: 960px) {
    .contact-grid {
      grid-template-columns: 0.92fr 1.08fr;
    }
  }
</style>
