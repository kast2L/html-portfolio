---
import Wordmark from './Wordmark.astro';
import { SITE } from '../lib/site';
const year = new Date().getFullYear();
---

<footer class="site-footer">
  <div class="container">
    <div class="footer-top">
      <div class="footer-brand">
        <Wordmark tone="light" instance="footer" />
        <p class="footer-line">
          Full-suite Microsoft Power Platform, Power BI intelligence, custom web applications, and cloud governance — architected end-to-end by one senior principal.
        </p>
      </div>

      <div class="footer-columns">
        <div class="footer-col">
          <p class="footer-heading">Studio</p>
          <ul class="footer-list">
            <li><a class="footer-link" href="/#capabilities">Capabilities</a></li>
            <li><a class="footer-link" href="/#work">Selected Work</a></li>
            <li><a class="footer-link" href="/#approach">Approach</a></li>
            <li><a class="footer-link" href="/#about">Principal</a></li>
          </ul>
        </div>

        <div class="footer-col">
          <p class="footer-heading">Connect</p>
          <ul class="footer-list">
            <li><a class="footer-link" href={`mailto:${SITE.email}`}>{SITE.email}</a></li>
            <li>
              <a class="footer-link" href={SITE.linkedin} target="_blank" rel="noopener noreferrer">
                LinkedIn<span class="sr-only"> (opens in a new tab)</span>
              </a>
            </li>
            <li><a class="footer-link" href={SITE.resumePdf}>Résumé (PDF)</a></li>
          </ul>
        </div>
      </div>
    </div>

    <div class="footer-bottom">
      <p class="footer-copy">
        &copy; {year} {SITE.business} &middot; {SITE.locality}, {SITE.regionName} (US Remote)
      </p>
      <nav aria-label="Legal">
        <ul class="footer-legal">
          <li><a class="footer-link" href="/privacy">Privacy</a></li>
          <li><a class="footer-link" href="/terms">Terms</a></li>
        </ul>
      </nav>
    </div>
  </div>
</footer>

<style>
  .site-footer {
    padding-block: clamp(3.5rem, 2.5rem + 3.5vw, 5.5rem) var(--s-6);
    border-top: 1px solid var(--c-line-dark);
    color: var(--c-on-night-2);
    font-size: var(--fs-small);
  }

  .footer-top {
    display: grid;
    gap: var(--s-7);
    padding-bottom: clamp(2.5rem, 1.8rem + 2vw, 3.75rem);
  }

  .footer-line {
    margin-top: var(--s-4);
    max-width: 42ch;
    line-height: 1.6;
    color: var(--c-on-night-2);
  }

  .footer-columns {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(11rem, 1fr));
    gap: var(--s-6);
  }

  .footer-heading {
    font-size: var(--fs-label);
    font-weight: var(--w-semibold);
    color: var(--c-on-night-3);
    margin-bottom: var(--s-2);
  }

  .footer-list {
    display: grid;
    gap: 0.1rem;
  }

  .footer-link {
    display: inline-flex;
    align-items: center;
    min-height: 44px;
    color: var(--c-on-night);
    text-decoration: none;
    overflow-wrap: anywhere;
    transition: color var(--dur-fast) var(--ease-fluid);
  }

  .footer-link:hover {
    color: var(--c-coral);
  }

  .footer-bottom {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: var(--s-3) var(--s-5);
    padding-top: var(--s-5);
    border-top: 1px solid var(--c-line-dark);
  }

  .footer-copy {
    font-size: var(--fs-label);
    color: var(--c-on-night-3);
  }

  .footer-legal {
    display: flex;
    gap: var(--s-5);
  }

  @media (min-width: 860px) {
    .footer-top {
      grid-template-columns: 1.15fr 1fr;
      align-items: start;
    }
  }
</style>
