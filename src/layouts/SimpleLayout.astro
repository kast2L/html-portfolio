---
import BaseLayout from './BaseLayout.astro';

interface Props {
  title: string;
  description: string;
  path: string;
  heading: string;
}
const { title, description, path, heading } = Astro.props;
---

<BaseLayout title={title} description={description} path={path} noindex>
  <section class="simple">
    <div class="container">
      <div class="simple-card">
        <h1 class="simple-title">{heading}</h1>
        <div class="simple-body">
          <slot />
        </div>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .simple {
    padding-block: clamp(3rem, 2rem + 4vw, 5.5rem) var(--section-pad);
    min-height: 68vh;
  }

  .simple-card {
    max-width: 48rem;
    padding: clamp(1.75rem, 1.25rem + 2.5vw, 3.25rem);
    border-radius: var(--r-card-lg);
    background: var(--c-night-2);
    border: 1px solid var(--c-line-dark);
    box-shadow: var(--shadow-stage);
  }

  .simple-title {
    font-size: var(--fs-h2);
    line-height: var(--lh-tight);
  }

  .simple-body {
    margin-top: var(--s-5);
    display: grid;
    gap: var(--s-5);
    justify-items: start;
  }

  .simple-body :global(p) {
    font-size: var(--fs-lead);
    line-height: 1.6;
    color: var(--c-on-night-2);
    max-width: 48ch;
  }

  .simple-body :global(.text-link) {
    min-height: 44px;
  }
</style>
